│ +echo "--- workers finished $(date '+%F %T') rc=$rc ---" >> l175/run.out
│ +if [ -f l175/verdict_l175.py ]; then
│ +  $PY l175/verdict_l175.py > l175/verdict.out 2>&1
│ +  echo "--- verdict exit $? $(date '+%F %T') ---" >> l175/run.out
│ +fi
