│ +# ---- my own Wilson score interval (no scipy) --------------------------------
│ +def wilson(k, n, z=1.959963984540054):
│ +    if n == 0:
│ +        return (float("nan"), float("nan"))
│ +    p = k / n
│ +    d = 1.0 + z * z / n
│ +    c = p + z * z / (2 * n)
│ +    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n))
│ +    return ((c - half) / d, (c + half) / d)
│ +
│ +print("=" * 72)
│ +print("REFEREE R4 RECOMPUTE — independent code")
│ +print("=" * 72)
