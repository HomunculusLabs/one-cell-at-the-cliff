+# ---- L100: diary night vision (owner-approved 11-16, BBS #54 11:40 hop) ----
+# Every entry is stamped with wall-clock seconds (the old `t` is a random
+# tie-break, useless for timing); identical consecutive acts within
+# DIARY_COALESCE_S coalesce into one counted entry (a night of 45-s naps
+# used to fill the 50-cap with identical lines within ~37 min of dusk);
+# entries evicted by the cap are appended to a jsonl archive first, so
+# week-scale diary evidence survives. Pure bookkeeping: ZERO rng draws
+# happen here (callers pass the t they already drew -- draw order is
+# behavior), and no branch logic anywhere reads these fields.
+DIARY_COALESCE_S = 900          # 15 min gap closes a run
+DIARY_KEEP = 50
+DIARY_ARCHIVE = os.path.join(
+    os.path.dirname(os.path.abspath(__file__)),
+    "sessions", "world_diary_archive.jsonl")
+
+
+def diary_append(s, act, text, t):
+    """Stamp, coalesce, archive-evict, append. Never raises into a tick."""
+    now = int(time.time())
+    try:
+        tail = s.diary[-1] if s.diary else None
+        if (tail is not None and "clock_s" in tail
+                and tail.get("act") == act
+                and tail.get("text") == text
+                and now - tail.get("clock_s_end", tail["clock_s"]) <= DIARY_COALESCE_S):
+            tail["n"] = tail.get("n", 1) + 1
+            tail["clock_s_end"] = now
+            return tail
+        evicted = []
+        if len(s.diary) >= DIARY_KEEP:
+            evicted = s.diary[:len(s.diary) - DIARY_KEEP + 1]
+        if evicted:
+            import json as _json
+            with open(DIARY_ARCHIVE, "a") as f:       # append-only, never rewrite
+                for e in evicted:
+                    f.write(_json.dumps(e, ensure_ascii=False) + "\n")
+            s.diary = s.diary[len(s.diary) - DIARY_KEEP + 1:]
+        s.diary.append({"t": t, "act": act, "text": text,
+                        "clock_s": now, "clock_s_end": now, "n": 1})
+        return s.diary[-1]
+    except Exception as exc:                     # persistence must not kill
+        print(f"[diary_append] archive failed (logged, kept in memory): "
+              f"{exc!r}", file=sys.stderr)
+        if len(s.diary) >= DIARY_KEEP:
+            s.diary = s.diary[-DIARY_KEEP:]
+        s.diary.append({"t": t, "act": act, "text": text,
+                        "clock_s": now, "clock_s_end": now, "n": 1})
+        return s.diary[-1]
